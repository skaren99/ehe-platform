{
  "realm": "ehe",
  "enabled": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "sslRequired": "none",
  "roles": {
    "realm": [
      {
        "name": "SITE_ADMIN"
      },
      {
        "name": "PLANNER"
      },
      {
        "name": "CLIENT"
      }
    ]
  },
  "clients": [
    {
      "clientId": "ehe-website",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "ehe-site-api",
            "id.token.claim": "false",
